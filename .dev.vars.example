# Secrets for the contact form (worker/index.js).
# Copy this file to `.dev.vars` and fill it in — `.dev.vars` is git-ignored and is read
# by `npx wrangler dev`. For the live site the same two names are set as secrets:
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_CHAT_ID
# (or in the Cloudflare dashboard: Workers → andrii-naumov → Settings → Variables and Secrets)

# From @BotFather in Telegram: /newbot, then copy the token
TELEGRAM_BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample

# The chat the bot writes to. Your own user id: write to @userinfobot in Telegram.
# For a group, add the bot to it and use the group id (starts with -100…).
TELEGRAM_CHAT_ID=123456789
