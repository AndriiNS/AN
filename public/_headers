# Cloudflare: HTTP headers for every response (Workers static assets and Pages read this file).
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# files with a hash in the name never change: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# screenshots, icons and the CV: a day in the browser, longer on Cloudflare's edge
/projects/*
  Cache-Control: public, max-age=86400, s-maxage=604800
/cv/*
  Cache-Control: public, max-age=3600, s-maxage=86400

# the HTML itself must always be checked, so a new deploy is visible right away
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/en
  Cache-Control: public, max-age=0, must-revalidate
/uk
  Cache-Control: public, max-age=0, must-revalidate
